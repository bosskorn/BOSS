{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/main",
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "node",
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["./core/*"]
    }
  },
  "include": ["app/main/**/*", "core/**/*"],
  "exclude": ["node_modules", "app/renderer"]
}
